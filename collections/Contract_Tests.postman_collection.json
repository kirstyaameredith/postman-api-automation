{
  "info": {
    "name": "Contract Tests (JSON Schema Validation)",
    "description": "Validates API responses against JSON schemas to ensure contract compliance",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "User Contract Tests",
      "item": [
        {
          "name": "Validate Single User Schema",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const schema = {",
                  "    \"$schema\": \"http://json-schema.org/draft-07/schema#\",",
                  "    \"type\": \"object\",",
                  "    \"required\": [\"id\", \"name\", \"username\", \"email\"],",
                  "    \"properties\": {",
                  "        \"id\": { \"type\": \"integer\", \"minimum\": 1 },",
                  "        \"name\": { \"type\": \"string\", \"minLength\": 1 },",
                  "        \"username\": { \"type\": \"string\", \"minLength\": 1 },",
                  "        \"email\": { \"type\": \"string\", \"pattern\": \"^[^@]+@[^@]+\\\\.[^@]+$\" },",
                  "        \"address\": { \"type\": \"object\" },",
                  "        \"phone\": { \"type\": \"string\" },",
                  "        \"website\": { \"type\": \"string\" },",
                  "        \"company\": { \"type\": \"object\" }",
                  "    }",
                  "};",
                  "",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"User schema is valid\", function () {",
                  "    pm.response.to.have.jsonSchema(schema);",
                  "});",
                  "",
                  "pm.test(\"User has all required fields\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "    pm.expect(jsonData).to.have.property('name');",
                  "    pm.expect(jsonData).to.have.property('username');",
                  "    pm.expect(jsonData).to.have.property('email');",
                  "});",
                  "",
                  "pm.test(\"User ID is a positive integer\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.id).to.be.a('number');",
                  "    pm.expect(jsonData.id).to.be.above(0);",
                  "});",
                  "",
                  "pm.test(\"Email format is valid\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    const emailRegex = /^[^@]+@[^@]+\\.[^@]+$/;",
                  "    pm.expect(emailRegex.test(jsonData.email)).to.be.true;",
                  "});",
                  "",
                  "console.log('✅ User contract validation passed');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://jsonplaceholder.typicode.com/users/1",
              "protocol": "https",
              "host": ["jsonplaceholder", "typicode", "com"],
              "path": ["users", "1"]
            }
          }
        },
        {
          "name": "Validate Users Array Schema",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const userSchema = {",
                  "    \"type\": \"object\",",
                  "    \"required\": [\"id\", \"name\", \"username\", \"email\"],",
                  "    \"properties\": {",
                  "        \"id\": { \"type\": \"integer\" },",
                  "        \"name\": { \"type\": \"string\" },",
                  "        \"username\": { \"type\": \"string\" },",
                  "        \"email\": { \"type\": \"string\" }",
                  "    }",
                  "};",
                  "",
                  "const arraySchema = {",
                  "    \"type\": \"array\",",
                  "    \"items\": userSchema,",
                  "    \"minItems\": 1",
                  "};",
                  "",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response is an array\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('array');",
                  "});",
                  "",
                  "pm.test(\"Users array schema is valid\", function () {",
                  "    pm.response.to.have.jsonSchema(arraySchema);",
                  "});",
                  "",
                  "pm.test(\"All users have required fields\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    jsonData.forEach(user => {",
                  "        pm.expect(user).to.have.property('id');",
                  "        pm.expect(user).to.have.property('name');",
                  "        pm.expect(user).to.have.property('username');",
                  "        pm.expect(user).to.have.property('email');",
                  "    });",
                  "});",
                  "",
                  "console.log('✅ Users array contract validation passed');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://jsonplaceholder.typicode.com/users",
              "protocol": "https",
              "host": ["jsonplaceholder", "typicode", "com"],
              "path": ["users"]
            }
          }
        }
      ]
    },
