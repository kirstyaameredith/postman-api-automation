{
  "info": {
    "name": "Performance Tests",
    "description": "Load and performance testing for JSONPlaceholder API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Load Test - GET Users",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const currentIteration = pm.info.iteration;",
              "const currentResponseTime = pm.response.responseTime;",
              "",
              "pm.test(`Iteration ${currentIteration + 1} - Status is 200`, function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(`Iteration ${currentIteration + 1} - Response time < 3000ms`, function () {",
              "    pm.expect(currentResponseTime).to.be.below(3000);",
              "});",
              "",
              "pm.test(`Iteration ${currentIteration + 1} - Returns array of users`, function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an('array');",
              "    pm.expect(jsonData.length).to.be.greaterThan(0);",
              "});",
              "",
              "console.log(`⏱️ GET Users - Iteration ${currentIteration + 1}: ${currentResponseTime}ms`);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://jsonplaceholder.typicode.com/users",
          "protocol": "https",
          "host": ["jsonplaceholder", "typicode", "com"],
          "path": ["users"]
        }
      }
    },
